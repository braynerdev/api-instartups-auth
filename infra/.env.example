# Copie para .env e preencha (ou cadastre as mesmas variáveis na stack do Portainer).
# Aqui fica só o que muda por ambiente ou é segredo; o resto está no appsettings.json da imagem.

# Imagem (tag publicada no GHCR: latest, develop, homolog, main, x.y.z, sha-xxxxxxx)
IMAGE_TAG=latest
ASPNETCORE_ENVIRONMENT=Production

# Subdomínio das APIs, o mesmo nas 3 (o Traefik separa pelo caminho)
API_DOMAIN=api.instartups.tech

# Banco gerenciado/externo
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# Prefer usa SSL se o servidor oferecer; troque para Require se o provedor exigir
DB_SSL_MODE=Prefer

# JWT: ISSUER e AUDIENCE iguais nas 3 APIs; arquivos com caminho ABSOLUTO no servidor
# (legíveis pelo uid 1654, usuário "app" do container)
JWT_PRIVATE_KEY_FILE=/opt/instartups/keys/jwt-private.pem
JWT_PUBLIC_KEY_FILE=/opt/instartups/keys/jwt-public.pem
JWT_ISSUER=
JWT_AUDIENCE=

# Chave AES-256 (base64) dos cursores de paginação. Gere com: openssl rand -base64 32
CURSOR_SECRET_KEY=

# Usuário admin semeado na inicialização (deixe vazio para não criar)
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
