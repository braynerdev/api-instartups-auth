# Copie para .env e preencha: cp .env.example .env

# Aplicação
IMAGE_TAG=latest
ASPNETCORE_ENVIRONMENT=Production
API_PORT=8080
TZ=America/Sao_Paulo

# Banco (PostgreSQL, schema "auth"). Para o Postgres da própria máquina use host.docker.internal
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=instartups_db
DB_USER=postgres
DB_PASSWORD=
DB_MIN_POOL_SIZE=0
DB_MAX_POOL_SIZE=50

# JWT: a privada assina os tokens; a pública é a mesma usada pela Command e pela Query
JWT_PRIVATE_KEY_FILE=
JWT_PUBLIC_KEY_FILE=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_EXPIRATION_MINUTES=60

# Sessões
REFRESH_TOKEN_EXPIRATION_DAYS=30

# Chave AES-256 (base64) dos cursores de paginação. Gere com: openssl rand -base64 32
CURSOR_SECRET_KEY=

# Usuário admin semeado na inicialização (deixe vazio para não criar)
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Limites do container
API_CPUS=1.0
API_MEMORY=512M
