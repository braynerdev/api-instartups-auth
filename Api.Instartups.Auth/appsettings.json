{
  "ConnectionStrings": {
    "PostgresConnection": ""
  },
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "PrivateKeyPath": "/run/keys/jwt-private.pem",
    "PublicKeyPath": "/run/keys/jwt-public.pem",
    "ExpirationMinutes": 60
  },
  "RefreshToken": {
    "ExpirationDays": 30
  },
  "Cursor": {
    "SecretKey": ""
  },
  "AdminUser": {
    "Email": "",
    "UserName": "",
    "Password": ""
  },
  "AppDoc": {
    "NomeApi": "API de Autenticação InStartups",
    "DescricaoApi": "API responsável pelo gerenciamento de autenticação e acesso aos serviços do sistema InStartups."
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Wolverine": "Warning",
        "Api.Instartups.Auth.Middleware": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Properties": {
      "Application": "Instartups.Auth"
    }
  },
  "AllowedHosts": "*"
}
